# Copy to .env and fill in for local dev. In production these are set as
# environment variables on the host (Vercel/Render), not via this file.

# --- Database ---
# Local Postgres, or leave as sqlite for a zero-setup dev DB:
#   DATABASE_URL=sqlite:///./cpf_live.sqlite3
DATABASE_URL=postgresql+psycopg://cpf:cpf@localhost:5432/cpf

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=^(https://.*\.vercel\.app|http://localhost:\d+)$

# --- AI policy PDF extraction (optional) ---
# Leave blank to use the fixture extractor (no real Claude calls) — fine for
# local dev and CI. Set a real key to test actual PDF ingestion.
ANTHROPIC_API_KEY=

# --- Admin auth ---
ADMIN_USERNAME=useradmin
# Production: set ADMIN_PASSWORD_HASH (bcrypt) instead of ADMIN_PASSWORD.
# If neither is set, admin login is disabled.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=change-me-locally
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-insecure-change-me-0000000000000000
JWT_EXPIRE_MINUTES=720
MEMBER_TOKEN_EXPIRE_MINUTES=30

# --- Error tracking (optional) ---
# Leave blank to disable. See app/core/logging.py.
SENTRY_DSN=

# --- Rate limiting ---
# Per-client-IP, applies to every route. See app/core/limiter.py.
RATE_LIMIT_DEFAULT=120/minute
